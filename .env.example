# ETNet Futures Exporter 設定檔
# 使用方法：複製本檔為 .env 並修改（.env 不會被提交到 GitHub）
# Usage: copy to .env and edit (values below are the built-in defaults)

# 資料來源網址 (data source URL)
ETNET_FUTURES_URL=https://www.etnet.com.hk/www/tc/futures/

# 下載逾時（秒）(request timeout in seconds)
REQUEST_TIMEOUT=30

# 瀏覽器 User-Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# 輸出資料夾；留空 = 桌面 (output folder; empty = Desktop)
# 例如: OUTPUT_DIR=C:\Users\YourName\Documents\FuturesData
OUTPUT_DIR=

# .xlsx 檔名前綴 (xlsx filename prefix)
DOWNLOAD_PREFIX=etnet_futures
